# Copied to settings.local.toml by a deployment, with its own values. Any key left out keeps the
# value settings.toml gives it; BMO_ARTIFACT_<TABLE>__<KEY> in the environment overrides both.

[server]
listen = "127.0.0.1:3230"
token = "artifact-token"

[console]
token = "artifact-console-token"
bundle = "/srv/bmo-artifact/console"

[database]
url = "postgres://artifact:secret@localhost:5432/bmo_artifact"

[files]
root = "/srv/bmo-artifact/files"

[explorer]
data_root = "/srv/bmo-artifact/data"

[share]
address = "https://documents.example.com/share"

[wording]
file = "/srv/bmo-artifact/documents.yaml"

[documents]
kindless_import_prefix = "Import: "

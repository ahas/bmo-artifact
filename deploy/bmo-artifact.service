# The neutral user unit of the document service. A deployment runs it from its deploy tree, whose
# settings.toml and settings.local.toml the server reads at start.
[Unit]
Description=bmo-artifact: documents kept, searched and shared
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/bmo-artifact/deploy
ExecStart=%h/.local/share/bmo-artifact/deploy/bin/bmo-artifact serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
# The one service a deployment waits on: linked and enabled, restarted, and watched staying up
# (docs/layout.md, 「The deploy declaration」).
X-BMO-Deploy=bot

{
  "$defs": {
    "Share": {
      "description": "A share link.",
      "properties": {
        "createdAt": {
          "description": "Epoch milliseconds.",
          "format": "int64",
          "type": "integer"
        },
        "documentId": {
          "format": "int64",
          "type": "integer"
        },
        "expiresAt": {
          "description": "Epoch milliseconds; null for a link with no end.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "token": {
          "type": "string"
        },
        "url": {
          "description": "The share address, a `/` and the token.",
          "type": "string"
        }
      },
      "required": [
        "token",
        "documentId",
        "url",
        "createdAt",
        "expiresAt"
      ],
      "type": "object"
    },
    "SharePage": {
      "description": "A page of live links, oldest first.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/Share"
          },
          "type": "array"
        },
        "more": {
          "type": "boolean"
        }
      },
      "required": [
        "items",
        "more"
      ],
      "type": "object"
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/SharePage"
    }
  ],
  "type": "object"
}

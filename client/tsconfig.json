{
  // Nuxt's own project configs carry the layer's code; the tests under tests/ are a project of their
  // own beside them, and so is the screen read with the components the host owes, so the typecheck
  // reads both too.
  "files": [],
  "references": [
    { "path": "./.nuxt/tsconfig.app.json" },
    { "path": "./.nuxt/tsconfig.server.json" },
    { "path": "./.nuxt/tsconfig.shared.json" },
    { "path": "./.nuxt/tsconfig.node.json" },
    { "path": "./tests" },
    { "path": "./host" }
  ]
}
